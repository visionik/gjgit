# Environment — never commit real credentials
.env

# Runtime data volumes (bind-mount dirs if used instead of named volumes)
data/
caddy_data/
caddy_config/
forgejo_data/
ghproxy_cache/

# Secrets — only .example templates are committed
secrets/*.env
secrets/*.token
secrets/*.key
secrets/*.pem
!secrets/*.example

# deft migration backups
*.premigrate.*
vbrief/migration/

# macOS
.DS_Store

# Local development overrides
docker-compose.override.yml

# Deployment bundles
gjgit-deploy-*.tar.gz

# fly.io
.fly/
*.fly.env

# Editor
.idea/
.vscode/
*.swp
*.swo
