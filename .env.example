# ============================================================
# gjgit — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains real credentials.
# ============================================================

# ── GLOBAL ───────────────────────────────────────────────────────────────────

# Your domain (e.g. git.yourdomain.ai) — must point to this VPS
DOMAIN=git.yourdomain.ai

# Email for Let's Encrypt TLS certificate registration
LETSENCRYPT_EMAIL=you@yourdomain.ai

# Host port Forgejo SSH listens on (default 2222; use 22 if running as root)
FORGEJO_SSH_PORT=2222

# UID/GID for the Forgejo process inside the container (match your VPS user)
USER_UID=1000
USER_GID=1000

# ── FORGEJO BOOTSTRAP ────────────────────────────────────────────────────────
# These credentials are used ONCE on first boot to create the admin user.
# Change GITEA_ADMIN_PASSWORD before deploying — do not leave the default!

# NOTE: 'admin' is a reserved username in Forgejo — use anything else (e.g. gitadmin, yourname)
GITEA_ADMIN_USERNAME=gitadmin
GITEA_ADMIN_PASSWORD=change-this-before-deploying!
GITEA_ADMIN_EMAIL=admin@yourdomain.ai

# Internal Forgejo URL (do not change unless you rename the forgejo service)
GITEA_URL=http://forgejo:3000

# Public URL Forgejo uses to generate clone URLs (fly.io: https://gjgit.fly.dev/)
# Also set FORGEJO__server__SSH_DOMAIN to your domain or app name
FORGEJO__server__ROOT_URL=https://gjgit.fly.dev/
FORGEJO__server__SSH_DOMAIN=gjgit.fly.dev

# ── PROXY MODE ───────────────────────────────────────────────────────────────
# Required when running: docker compose --profile proxy up -d

# GitHub repo or org to mirror (format: owner/repo or owner for full org)
GITHUB_REPO=owner/repo

# GitHub Personal Access Token with repo scope (required for private repos,
# issue mirroring, release assets, and LFS)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# How often gitea-mirror syncs from GitHub (e.g. 15m, 1h)
MIRROR_INTERVAL=15m

# Mirror GitHub issues and PRs as Forgejo issues (true/false)
MIRROR_ISSUES=true

# Mirror GitHub releases (true/false)
MIRROR_RELEASES=true

# Mirror Git LFS objects (true/false)
MIRROR_LFS=true

# ── HIGH-VOLUME / CHINA TWEAKS ───────────────────────────────────────────────
# Tune for high-traffic deployments (e.g. HK/LA CN2 GIA VPS)

# Maximum disk space for ghproxy hybrid cache (e.g. 20G, 50G)
GH_PROXY_CACHE_SIZE=20G

# ghproxy requests-per-second rate limit per IP (0 = unlimited)
GH_PROXY_RATE_LIMIT_RPS=200
